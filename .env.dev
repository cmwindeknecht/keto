# Development environment configuration
# IMPORTANT: Do NOT commit secrets to this file. Use .env.local for local overrides.

ENVIRONMENT=dev
DEBUG=True

# Dev database connection string must be set in .env.dev.local or environment variable
# Example: postgresql+asyncpg://postgres:password@dev-db.example.com:5432/keto_dev

# Dev Redis
REDIS_URL=redis://dev-redis.example.com:6379
