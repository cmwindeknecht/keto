# Production environment configuration

ENVIRONMENT=prod
DEBUG=False

# Production database (Supabase or prod Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:PROD_PASSWORD_HERE@prod-db.example.com:5432/steamanalytics

# Production Redis
REDIS_URL=redis://prod-redis.example.com:6379

# Production Steam API
STEAM_API_KEY=prod_steam_api_key_here
