# Production environment configuration
# IMPORTANT: Do NOT commit secrets to this file. Use .env.prod.local or secure secrets manager.

ENVIRONMENT=prod
DEBUG=False

# Production database connection string must be set via secure secrets management
# Example: postgresql+asyncpg://postgres:password@prod-db.example.com:5432/keto

# Production Redis
REDIS_URL=redis://prod-redis.example.com:6379
